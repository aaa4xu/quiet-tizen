<Project>
  <!-- Code that is compiled into the TV assembly: the TV runs .NET 6 and gets no NuGet packages.
       QuietHome.Core.csproj and ../tizen/Home.csproj import this; QuickLaunch and Probe do not. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Core code states where null is allowed and the build fails on a possible null dereference.
         launcher/tizen/Home.cs opts out with #nullable disable until it is rewritten. -->
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>
</Project>
