<Project Sdk="Microsoft.NET.Sdk">
  <!-- Quiet Home logic without Tizen references. The TV build compiles these sources into its
       single entry assembly (../tizen/Home.csproj); this project exists for tests on a computer. -->
  <Import Project="CoreCompile.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- Every public type and member needs a /// comment (AGENTS.md, "C# code"); the build fails without one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>
</Project>
