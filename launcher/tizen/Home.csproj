<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>Exe</OutputType><AssemblyName>BixbyPromotion</AssemblyName>
  <UseAppHost>false</UseAppHost><EnableDefaultCompileItems>false</EnableDefaultCompileItems><DebugType>none</DebugType>
 </PropertyGroup>
 <Import Project="../core/CoreCompile.props" />
 <!-- The core's sources go into this one assembly; its own build output must not. -->
 <ItemGroup><Compile Include="Home.cs" /><Compile Include="Interop/**/*.cs" /><Compile Include="Platform/**/*.cs" /><Compile Include="../core/**/*.cs" Exclude="../core/obj/**;../core/bin/**" /></ItemGroup>
 <Import Project="QuietHomeContainer.targets" />
 <ItemGroup>
  <Reference Include="Tizen.NUI"><HintPath>$(TV_FRAMEWORK_DIR)/Tizen.NUI.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="Tizen.Applications.Common"><HintPath>$(TV_FRAMEWORK_DIR)/Tizen.Applications.Common.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="Tizen.System"><HintPath>$(TV_FRAMEWORK_DIR)/Tizen.System.dll</HintPath><Private>false</Private></Reference>
  <Reference Include="Tizen"><HintPath>$(TV_FRAMEWORK_DIR)/Tizen.dll</HintPath><Private>false</Private></Reference>
 </ItemGroup>
</Project>
